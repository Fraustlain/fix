    CLASS lcl_parallel_processor IMPLEMENTATION.

      METHOD do.
        DATA:
          ls_task_input TYPE ty_task_input,
          lt_gldata_sel TYPE tt_data,
          ls_attrib     TYPE ty_attrib.
        TRY.
            IMPORT task_data = ls_task_input FROM DATA BUFFER p_in.
            IMPORT task_data_all = ls_attrib FROM DATA BUFFER p_in_all.
          CATCH cx_sy_import_mismatch_error.

            RETURN.


        ENDTRY.

        IF ls_task_input-gldata_sel IS INITIAL.
          RETURN.
        ENDIF.

        lt_gldata_sel = ls_task_input-gldata_sel.
        DATA(lo_main) = NEW lcl_main(  ).
        IF lo_main IS BOUND.
          "setting up imported data values
          lo_main->gt_gl_data = lt_gldata_sel.
          lo_main->gs_attrib  = ls_attrib.
          lo_main->run_proc_parallel( ).
        ENDIF.
        EXPORT results = gt_results TO DATA BUFFER p_out.

      ENDMETHOD.

      METHOD handle_results.

        DATA: lt_task_results TYPE tt_task_result,
              ls_doc_result   TYPE ty_task_result.


        LOOP AT p_all_results INTO DATA(ls_task_results).
          IMPORT results = lt_task_results FROM DATA BUFFER ls_task_results-result.
          ADD 1 TO gv_cnt.
          LOOP AT lt_task_results INTO ls_doc_result.
            WRITE:/ |Process: { gv_cnt }: { ls_doc_result-records } Records Updated | ##NO_TEXT.
          ENDLOOP.


        ENDLOOP.




      ENDMETHOD.

    ENDCLASS.
