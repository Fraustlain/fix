    CLASS lcl_main IMPLEMENTATION.

      METHOD constructor.
        SELECT *
          FROM ztr_fx_category
          WHERE bs_account IS NOT INITIAL
          INTO TABLE @gt_model.

        SELECT SINGLE low
          FROM tvarvc
          WHERE name = @gc_clean
            AND type = @gc_p
          INTO @DATA(lv_clean).
        IF sy-subrc EQ 0.
          gv_clean = lv_clean.
        ENDIF.

        SELECT SINGLE *
          FROM tvarvc
          WHERE name = @gc_last_run
            AND type = @gc_p
          INTO @gs_last_run.

        SELECT bukrs, saknr
          FROM skb1
          WHERE xsalh = @abap_true
        INTO TABLE @gt_skb1.

        "BOC of JIRA: FSFXBAM-601 465794779093
        "Get tvarvc entries matching for Stream
        SELECT *
          FROM tvarvc
          WHERE name = @gc_stream
            AND type = @gc_s
        INTO TABLE @gt_tvarvc_bhfs.

        "Get Intercompany GL's
        SELECT *
          FROM tvarvc
          WHERE name = @gc_ic_gl
            AND type = @gc_s
        INTO TABLE @gt_tvarvc_ic_gl.

        "Get IC Operation Type
        SELECT *
          FROM tvarvc
          WHERE name = @gc_ic_optype
            AND type = @gc_s
        INTO TABLE @gt_tvarvc_ic_optype.

        "IC Operation will start with below values
*        gr_ic_gl = VALUE #( sign = gc_i option = gc_cp
*                             ( low = '3137*' )
*                             ( low = '1637*' ) ).
*        gr_ic_optype = VALUE #( ( sign = gc_i  option = gc_cp
*                                low = 'IC*' ) ).



        gr_ic_gl = VALUE #( FOR ls IN gt_tvarvc_ic_gl
                              ( sign   = ls-sign
                                option = ls-opti
                                low    = |{ ls-low ALPHA = IN WIDTH = 10 }|
                                high   = |{ ls-high ALPHA = IN WIDTH = 10 }| ) ).

        gr_ic_optype = VALUE #( FOR ls IN gt_tvarvc_ic_optype
                              ( sign   = ls-sign
                                option = ls-opti
                                low    = ls-low ) ).
        "EOC of JIRA: FSFXBAM-601 465794779093
      ENDMETHOD.

      METHOD validate_selection.
        CHECK sy-batch = abap_false.
        IF p_datefr IS INITIAL AND p_dateto IS INITIAL.
          MESSAGE TEXT-e01 TYPE gc_e DISPLAY LIKE gc_s.
        ENDIF.

*BOC of JIRA: FSFXBAM-601 Validation for Parallel Processing
        IF cb_par = abap_true.
          IF p_batch <= 0.
            MESSAGE TEXT-e03 TYPE gc_e DISPLAY LIKE gc_s.
          ENDIF.
          IF p_cursor <= 0.
            MESSAGE TEXT-e04 TYPE gc_e DISPLAY LIKE gc_s.
          ENDIF.
          IF p_num <= 0.
            MESSAGE TEXT-e05 TYPE gc_e DISPLAY LIKE gc_s.
          ENDIF.
          IF p_perc < 1 OR p_perc > 100.
            MESSAGE TEXT-e06 TYPE gc_e DISPLAY LIKE gc_s.
          ENDIF.
        ENDIF.
*BOC of JIRA: FSFXBAM-601
      ENDMETHOD.


