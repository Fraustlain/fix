      METHOD init_context.
        gv_datefr = i_datefr.
        gv_timefr = i_timefr.
        gv_dateto = i_dateto.
        gv_timeto = i_timeto.
        gv_sim    = i_sim.
      ENDMETHOD.

      METHOD get_kf_selections.
        SELECT sign, opti, low, high FROM tvarvc
          INTO TABLE @gr_kf_list
          WHERE name = @gc_kf_exp
            AND type = @gc_s.

        SELECT *
          FROM fxm_kf_def
          WHERE kf IN @gr_kf_list
          INTO TABLE @gt_kf_def.

        SELECT *
          FROM fxm_kf_sel
          WHERE kf IN @gr_kf_list
            AND low IS NOT NULL
          INTO TABLE @gt_kf_sel.

        LOOP AT gt_kf_sel ASSIGNING FIELD-SYMBOL(<s>).
          CASE <s>-fieldname.
            WHEN gc_fi_account.
              APPEND VALUE #( sign    = <s>-sign
                              option  = <s>-sel_option
                              low     = <s>-low
                              high    = COND #( WHEN <s>-sel_option = gc_bt THEN <s>-high ELSE '' ) ) TO gr_racct.
            WHEN gc_fi_document_type.
              IF <s>-sign = gc_i.
                APPEND VALUE #( sign    = <s>-sign
                                option  = <s>-sel_option
                                low     = <s>-low
                                high    = COND #( WHEN <s>-sel_option = gc_bt THEN <s>-high ELSE '' ) ) TO gr_blart_incl.
              ENDIF.
              IF <s>-sign = gc_e.
                APPEND VALUE #( sign    = <s>-sign
                                option  = <s>-sel_option
                                low     = <s>-low
                                high    = COND #( WHEN <s>-sel_option = gc_bt THEN <s>-high ELSE '' ) ) TO gr_blart_excl.
              ENDIF.
            WHEN gc_planning_level.
              APPEND VALUE #( sign    = <s>-sign
                              option  = <s>-sel_option
                              low     = <s>-low
                              high    = COND #( WHEN <s>-sel_option = gc_bt THEN <s>-high ELSE '' ) ) TO gr_plan_lvl.
          ENDCASE.
        ENDLOOP.
      ENDMETHOD.

      METHOD get_latest_snapshot_timestamp.
        " Foreground/Background provided timestamp;
        IF sy-batch = abap_false
          OR ( sy-batch = abap_true
          AND gv_datefr IS NOT INITIAL
          AND gv_dateto IS NOT INITIAL ).

          CONVERT DATE gv_datefr TIME gv_timefr
                  INTO TIME STAMP gv_timestampfr
                  TIME ZONE gc_tzone.

          CONVERT DATE gv_dateto TIME gv_timeto
                  INTO TIME STAMP gv_timestampto
                  TIME ZONE gc_tzone.

          APPEND VALUE #( sign = gc_i
                          option = gc_bt
                          low = gv_timestampfr
                          high = gv_timestampto ) TO gr_timestamp.

        ELSE.
          " current and last run timestamp.
          GET TIME STAMP FIELD DATA(lv_current).
          APPEND VALUE #( sign    = gc_i
                          option  = gc_bt
                          low     = COND #( WHEN gs_last_run-low IS INITIAL
                                            THEN lv_current
                                            ELSE gs_last_run-low )
                          high    = lv_current  ) TO gr_timestamp.

          gs_last_run-low = lv_current.
          MODIFY tvarvc FROM gs_last_run.
        ENDIF.

      ENDMETHOD.

      METHOD get_gl_data.
        FREE gt_gl_data.
        SELECT
          b~rbukrs,
          b~timestamp,
          b~drcrk,
          b~rtcur,
          b~tsl,
          b~rwcur,
          b~wsl,
          b~rhcur,
          b~hsl,
          b~budat,
          b~blart,
          b~racct,
          b~belnr,
          b~gjahr,
          b~sgtxt,
          b~gkont,
          b~awtyp,
          b~docln,
          b~awref,
          b~aworg,
          b~zuonr,
          c~xref1
          FROM acdoca AS b
          LEFT OUTER JOIN bseg AS c
             ON c~bukrs = b~rbukrs
            AND c~belnr = b~belnr
            AND c~gjahr = b~gjahr
            AND c~hkont = b~racct
            AND lpad( c~buzei,6, '0' ) = b~docln
          WHERE b~rldnr     = '0L'
            AND b~timestamp IN @gr_timestamp
            AND ( b~rtcur <> b~rhcur
             OR b~rwcur   <> b~rhcur )
*        AND b~budat   <= @sy-datum  "(-) of JIRA: FSFXBAM-348
            AND b~tsl     <> 0
            AND b~blart   IN @gr_blart_incl
        INTO TABLE @DATA(lt_gl_temp).
        IF sy-subrc = 0.
          DELETE lt_gl_temp WHERE blart NOT IN gr_blart_excl. "#EC CI_STDSEQ

          LOOP AT lt_gl_temp ASSIGNING FIELD-SYMBOL(<lfs_temp>).

*BOC of JIRA: FSFXBAM-601
            IF <lfs_temp>-rtcur <> <lfs_temp>-rhcur
              AND <lfs_temp>-racct IN gr_racct.
              gt_gl_data = VALUE #( BASE gt_gl_data ( <lfs_temp> ) ).
            ENDIF.

            IF <lfs_temp>-rwcur <> <lfs_temp>-rhcur.
              IF line_exists( gt_skb1[ bukrs = <lfs_temp>-rbukrs saknr = <lfs_temp>-racct ] ).
                gt_gl_data = VALUE #( BASE gt_gl_data ( <lfs_temp> ) ).
              ENDIF.
            ENDIF.
*            IF ( <lfs_temp>-rtcur <> <lfs_temp>-rhcur
*               AND <lfs_temp>-racct IN gr_racct )
*             OR ( <lfs_temp>-rwcur <> <lfs_temp>-rhcur
*               AND line_exists(
*                    gt_skb1[
*                      bukrs = <lfs_temp>-rbukrs
*                      saknr = <lfs_temp>-racct ] ) ).
*
*              APPEND <lfs_temp> TO gt_gl_data.
*            ENDIF.



*BOC of JIRA: FSFXBAM-601




          ENDLOOP.
        ENDIF.
      ENDMETHOD.

      METHOD get_fica_data.
        DATA: lt_bukrs     TYPE STANDARD TABLE OF fkkr_bukrs,
              lt_budat     TYPE STANDARD TABLE OF fkkr_budat,
              lt_abs_sumsz TYPE STANDARD TABLE OF fkk_abs_sumsz,
              lt_abs_sum   TYPE STANDARD TABLE OF fkk_abs_sum,
              lr_bukrs     TYPE RANGE OF bukrs.

        CHECK gt_gl_data IS NOT INITIAL.

        "build company code
        lt_bukrs = VALUE #( FOR fica IN gt_gl_data
                            WHERE ( awtyp = gc_fkksu )
                            ( sign = gc_i option = gc_eq low = fica-rbukrs ) ). "#EC CI_STDSEQ

        SORT lt_bukrs BY low.
        DELETE ADJACENT DUPLICATES FROM lt_bukrs COMPARING low.

        "build posting date
        lt_budat = VALUE #( FOR fica IN gt_gl_data
                            WHERE ( awtyp = gc_fkksu )
                            ( sign = gc_i option = gc_eq low = fica-budat ) ). "#EC CI_STDSEQ

        SORT lt_budat BY low.
        DELETE ADJACENT DUPLICATES FROM lt_budat COMPARING low.

        "build reconciliation key
        lt_abs_sumsz = VALUE #( FOR fica IN gt_gl_data
                                WHERE ( awtyp = gc_fkksu )
*                                ( fikey = fica-awref+0(10) && fica-aworg+0(2)                               "(-) of JIRA: FSFXFAM-601
                                 ( fikey = |{ fica-awref+0(10) WIDTH = 10 ALIGN = LEFT }{ fica-aworg+0(2) }| "(+) of JIRA: FSFXBAM-601
                                  sumsz = CONV sumsz_kk( fica-xref1 ) bukrs = fica-rbukrs
                                  belnr = fica-belnr gjahr = fica-gjahr buzei = fica-docln ) ). "#EC CI_STDSEQ

        CHECK lt_abs_sumsz IS NOT INITIAL.
        CALL FUNCTION 'FKK_FICA_TOTALS_SELECT'
          EXPORTING
            i_gl_posted_only = abap_true
          TABLES
            t_bukrs          = lt_bukrs
            t_budat          = lt_budat
            t_in_sumsz       = lt_abs_sumsz
            t_out_sum        = lt_abs_sum
          EXCEPTIONS
            no_data_selected = 2.
        IF sy-subrc = 0.
          CALL FUNCTION 'FKK_DOC_TO_TOTALS_RECONCILIATE'
            TABLES
              t_bukrs             = lt_bukrs
              t_in_sum            = lt_abs_sum
              t_out_it            = gt_abs_items
            EXCEPTIONS
              no_data_selected    = 2
              selection_cancelled = 3.

          IF sy-subrc = 0.
*                DELETE gt_abs_items WHERE vkont IS INITIAL. "#EC CI_STDSEQ
            IF gt_tvarvc_bhfs IS NOT INITIAL.                                                                       "(+) of JIRA: FSFXBAM-601
              lr_bukrs = VALUE #( FOR ls_bhfs IN gt_tvarvc_bhfs ( sign = 'I' option = 'EQ' low = ls_bhfs-low ) ).
              DELETE gt_abs_items WHERE bukrs NOT IN lr_bukrs AND vkont IS INITIAL.
            ENDIF.                                                                                                  "(+) of JIRA: FSFXBAM-601
          ENDIF.                                                                                                    "(+) of JIRA: FSFXBAM-601
        ENDIF.

        "Get FICA details
        CHECK gt_abs_items IS NOT INITIAL.
        SELECT
          b~opbel,
          b~blart,
          b~ernam,
          c~hvorg,
          c~tvorg
          FROM dfkkko AS b
          LEFT OUTER JOIN dfkkop AS c
                  ON c~opbel = b~opbel
          FOR ALL ENTRIES IN @gt_abs_items
          WHERE b~opbel = @gt_abs_items-opbel
        INTO TABLE @gt_fica_data.


        "BOC of JIRA: FSFXBAM-601 465794779093
        "Collect intercompany FI-CA documents(opbel) into gt_fica_ic by IC GL account/op-type
        SELECT opbel, hkont, zz1_operationtype_opk
          FROM dfkkopk
          FOR ALL ENTRIES IN @gt_abs_items
          WHERE opbel = @gt_abs_items-opbel
        INTO TABLE @DATA(lt_opk).

        LOOP AT lt_opk ASSIGNING FIELD-SYMBOL(<opk>).
          IF <opk>-hkont                 IN gr_ic_gl
          OR <opk>-zz1_operationtype_opk IN gr_ic_optype.
            INSERT VALUE #( opbel = <opk>-opbel ) INTO TABLE gt_fica_ic.
          ENDIF.
        ENDLOOP.
        "EOC of JIRA: FSFXBAM-601 465794779093
      ENDMETHOD.

      METHOD get_memo_data.

        DATA: lr_idenr TYPE RANGE OF idenr.

        SELECT
          bukrs,
          waers
          FROM t001
        INTO TABLE @DATA(lt_t001).

        IF gv_dateto IS NOT INITIAL.
          DATA(lv_keydate) = gv_dateto.
        ELSE.
          lv_keydate = sy-datum.
        ENDIF.

        FREE gt_memo_data.
        SELECT
          fdes~idenr,
          fdes~bukrs,
          fdes~bnkko,
          fdes~ebene,
          fdes~dispw,
          fdes~wrshb,
          fdes~dmshb,
          fdes~hzdat,
          fdes~avdat,
          fdes~merkm,
          fqm_flow~create_timestamp AS timestamp,
          fqm_flow~certainty_level AS cert_level
          FROM fdes
          INNER JOIN fqm_flow
            ON fdes~idenr = fqm_flow~origin_document_id
          WHERE fqm_flow~certainty_level = @gc_memo
            AND fqm_flow~create_timestamp IN @gr_timestamp
            AND fdes~ebene IN @gr_plan_lvl
            AND fdes~wrshb <> 0
            AND fdes~avdat >= @lv_keydate
        INTO CORRESPONDING FIELDS OF TABLE @gt_memo_data.
        IF sy-subrc = 0.
          LOOP AT gt_memo_data ASSIGNING FIELD-SYMBOL(<memo>).
            <memo>-waers = VALUE #( lt_t001[ bukrs = <memo>-bukrs ]-waers OPTIONAL ). "#EC CI_STDSEQ
            " check curr plan not equal to cc curr
            IF <memo>-dispw = <memo>-waers.
              lr_idenr = VALUE #( BASE lr_idenr
                                  ( sign = gc_i option = gc_eq low = <memo>-idenr ) ).
            ENDIF.
            " No amt. in local curr, convert amt. plan
            IF <memo>-dmshb IS INITIAL.
              <memo>-dmshb = convert_to_eur( iv_date = <memo>-avdat iv_curr = <memo>-dispw iv_amt = <memo>-wrshb ).
            ENDIF.
          ENDLOOP.
        ENDIF.

        IF lr_idenr IS NOT INITIAL.
          DELETE gt_memo_data WHERE idenr IN lr_idenr.   "#EC CI_STDSEQ
        ENDIF.
      ENDMETHOD.

      METHOD build_tab.
        "Local Data Declarations
        DATA: lv_timestamp TYPE string,
              lv_model     TYPE zde_model,
              lv_source    TYPE fxm_datasource,
              ls_gl        TYPE ty_gl,
              ls_fica      TYPE fkk_abs_items,
              ls_memo      TYPE ty_memo.

        "Looping over the GL Data to get final Snapshot data
        IF gt_gl_data IS NOT INITIAL.
          LOOP AT gt_gl_data INTO ls_gl.
            "Get Model
            lv_model  = VALUE #( gt_model[ bs_account = ls_gl-racct ]-model OPTIONAL ). "#EC CI_STDSEQ
            "get the Data source
            lv_source = VALUE #( gt_kf_def[ kf = VALUE #( gt_kf_sel[ low = ls_gl-racct ]-kf OPTIONAL ) ]-datasource OPTIONAL ). "#EC CI_STDSEQ
            IF ls_gl-awtyp = gc_fkksu.
              "Check Reconciliation Key and Summary of the record
*             IF line_exists( gt_abs_items[ fikey = ls_gl-awref+0(10) && ls_gl-aworg+0(2)                                "(-) of JIRA: FSFXBAM-601
              IF line_exists( gt_abs_items[ fikey  = |{ ls_gl-awref+0(10) WIDTH = 10 ALIGN = LEFT }{ ls_gl-aworg+0(2) }| "(+) of JIRA: FSFXBAM-601
                                            sumsz = CONV sumsz_kk( ls_gl-xref1 ) ] ). "#EC CI_STDSEQ

                LOOP AT gt_abs_items INTO ls_fica
*                                    WHERE ( fikey = ls_gl-awref+0(10) && ls_gl-aworg+0(2)                               "(-) of JIRA: FSFXBAM-601
                                     WHERE ( fikey = |{ ls_gl-awref+0(10) WIDTH = 10 ALIGN = LEFT }{ ls_gl-aworg+0(2) }| "(+) of JIRA: FSFXBAM-601
                                             AND sumsz = CONV sumsz_kk( ls_gl-xref1 ) ). "#EC CI_STDSEQ
                  APPEND VALUE #(
                    guid        = guid( )
                    bukrs       = ls_gl-rbukrs
                    gjahr       = ls_gl-gjahr
                    belnr       = ls_gl-belnr
                    docln       = ls_gl-docln
                    timestamp   = ls_gl-timestamp
                    fica_opbel  = ls_fica-opbel
                    model       = lv_model
                    "call method to get the category
                    category    = get_snapshot_category( rs_gl      = ls_gl
                                                         rs_fica    = ls_fica
                                                         rs_memo    = ls_memo
                                                         iv_model   = lv_model
                                                         iv_source  = lv_source )
                    racct       = ls_gl-racct
                    rtcur       = ls_fica-pswsl
                    tsl         = CONV fins_vwcur12( |{ ls_fica-pswbt CURRENCY = ls_fica-pswsl }| )
                    rwcur       = ls_fica-waers
                    wsl         = CONV fins_vwcur12( |{ ls_fica-betrw CURRENCY = ls_fica-waers }| )
                    rhcur       = ls_fica-hwaer
                    hsl         = CONV fins_vwcur12( |{ ls_fica-betrh CURRENCY = ls_fica-hwaer }| )
                    budat       = ls_gl-budat
                    sgtxt       = ls_gl-sgtxt
                    zuonr       = ls_gl-zuonr
                    blart       = ls_gl-blart
                    gkont       = ls_gl-gkont
                    datasource  = lv_source
                    fica_flag   = abap_true
                    fica_augbl  = ls_fica-augbl
                    fica_blart  = VALUE #( gt_fica_data[ opbel = ls_fica-opbel ]-blart OPTIONAL )
                    fica_ernam  = VALUE #( gt_fica_data[ opbel = ls_fica-opbel ]-ernam OPTIONAL )
                    fica_hvorg  = VALUE #( gt_fica_data[ opbel = ls_fica-opbel ]-hvorg OPTIONAL )
                    fica_tvorg  = VALUE #( gt_fica_data[ opbel = ls_fica-opbel ]-tvorg OPTIONAL )
                  ) TO gt_snapshot_tab.                  "#EC CI_STDSEQ

                  CLEAR ls_fica.
                ENDLOOP.
              ELSE.
                APPEND VALUE #(
                  guid            = guid( )
                  bukrs           = ls_gl-rbukrs
                  gjahr           = ls_gl-gjahr
                  belnr           = ls_gl-belnr
                  docln           = ls_gl-docln
                  timestamp       = ls_gl-timestamp
                  model           = lv_model
                  category        = get_snapshot_category( rs_gl      = ls_gl
                                                           rs_fica    = ls_fica
                                                           rs_memo    = ls_memo
                                                           iv_model   = lv_model
                                                           iv_source  = lv_source )
                  racct           = ls_gl-racct
                  rtcur           = COND #( WHEN ls_gl-rtcur = ls_gl-rhcur
                                             AND ls_gl-rwcur <> ls_gl-rhcur
                                            THEN ls_gl-rwcur
                                            ELSE ls_gl-rtcur )
                  tsl             = COND #( WHEN ls_gl-rtcur = ls_gl-rhcur
                                             AND ls_gl-rwcur <> ls_gl-rhcur
                                            THEN CONV fins_vwcur12( |{ ls_gl-wsl CURRENCY = ls_gl-rwcur }| ) "BOC of JIRA: FSFXBAM-348
                                            ELSE CONV fins_vwcur12( |{ ls_gl-tsl CURRENCY = ls_gl-rtcur }| ) )
                  rwcur           = ls_gl-rwcur
                  wsl             = CONV fins_vwcur12( |{ ls_gl-wsl CURRENCY = ls_gl-rwcur }| )
                  rhcur           = ls_gl-rhcur
                  hsl             = CONV fins_vwcur12( |{ ls_gl-hsl CURRENCY = ls_gl-rhcur }| )
                  budat           = ls_gl-budat
                  sgtxt           = ls_gl-sgtxt
                  zuonr           = ls_gl-zuonr
                  blart           = ls_gl-blart
                  gkont           = ls_gl-gkont
                  datasource      = lv_source
                  fica_flag       = abap_true
                ) TO gt_snapshot_tab.                    "#EC CI_STDSEQ
              ENDIF.
            ELSE.
              APPEND VALUE #(
                guid            = guid( )
                bukrs           = ls_gl-rbukrs
                gjahr           = ls_gl-gjahr
                belnr           = ls_gl-belnr
                docln           = ls_gl-docln
                timestamp       = ls_gl-timestamp
                model           = lv_model
                category        = get_snapshot_category( rs_gl      = ls_gl
                                                         rs_fica    = ls_fica
                                                         rs_memo    = ls_memo
                                                         iv_model   = lv_model
                                                         iv_source  = lv_source )
                racct           = ls_gl-racct
                rtcur           = COND #( WHEN ls_gl-rtcur = ls_gl-rhcur
                                           AND ls_gl-rwcur <> ls_gl-rhcur
                                          THEN ls_gl-rwcur
                                          ELSE ls_gl-rtcur )
                tsl             = COND #( WHEN ls_gl-rtcur = ls_gl-rhcur
                                           AND ls_gl-rwcur <> ls_gl-rhcur
                                          THEN CONV fins_vwcur12( |{ ls_gl-wsl CURRENCY = ls_gl-rwcur }| ) "BOC of JIRA: FSFXBAM-348
                                          ELSE CONV fins_vwcur12( |{ ls_gl-tsl CURRENCY = ls_gl-rtcur }| ) )
                rwcur           = ls_gl-rwcur
                wsl             = CONV fins_vwcur12( |{ ls_gl-wsl CURRENCY = ls_gl-rwcur }| )
                rhcur           = ls_gl-rhcur
                hsl             = CONV fins_vwcur12( |{ ls_gl-hsl CURRENCY = ls_gl-rhcur }| )
                budat           = ls_gl-budat
                sgtxt           = ls_gl-sgtxt
                zuonr           = ls_gl-zuonr
                blart           = ls_gl-blart
                gkont           = ls_gl-gkont
                datasource      = lv_source
              ) TO gt_snapshot_tab.                      "#EC CI_STDSEQ
            ENDIF.
            CLEAR: lv_model, lv_source, ls_gl.
          ENDLOOP.
        ENDIF.

        IF gt_memo_data IS NOT INITIAL.
          LOOP AT gt_memo_data INTO ls_memo.

            lv_model = COND #( WHEN ls_memo-bnkko IS INITIAL AND ls_memo-ebene = 'GU'
                                THEN VALUE #( gt_model[ bs_account = 'GUSTAV' ]-model OPTIONAL )
                               WHEN ls_memo-bnkko IS INITIAL AND ls_memo-ebene = 'GT'
                                THEN VALUE #( gt_model[ bs_account = 'GUSTAV_TBI' ]-model OPTIONAL )
                               ELSE
                                VALUE #( gt_model[ bs_account = ls_memo-bnkko ]-model OPTIONAL ) ). "#EC CI_STDSEQ
            lv_source = VALUE #( gt_kf_def[ kf = gc_oneexp ]-datasource OPTIONAL ). "#EC CI_STDSEQ
            lv_timestamp = |{ ls_memo-timestamp TIMESTAMP = USER TIMEZONE = gc_tzone }|. "#EC CI_STDSEQ

            " B.O.C VKANDASAMY FSFXBAM-426
            DATA(lv_doc) = |{ condense( val = ls_memo-idenr del = '0' ) && '999' WIDTH = 10 ALIGN = RIGHT PAD = '0' }|.
            DATA(lv_timestmp) = CONV timestamp( |{ ls_memo-avdat }000000| ).
            " E.O.C VKANDASAMY FSFXBAM-426

            APPEND VALUE #(
              guid            = guid( )
              bukrs           = ls_memo-bukrs
              gjahr           = lv_timestamp+6(4)
              belnr           = ls_memo-idenr
              docln           = ls_memo-idenr+4(6)
              timestamp       = ls_memo-timestamp
              model           = lv_model
              category        = get_snapshot_category( rs_gl      = ls_gl
                                                       rs_fica    = ls_fica
                                                       rs_memo    = ls_memo
                                                       iv_model   = lv_model
                                                       iv_source  = lv_source )
              racct           = ls_memo-bnkko
              rtcur           = ls_memo-dispw
              tsl             = CONV fins_vwcur12( |{ ls_memo-wrshb CURRENCY = ls_memo-dispw }| )
              rhcur           = ls_memo-waers
              hsl             = CONV fins_vwcur12( |{ ls_memo-dmshb CURRENCY = ls_memo-waers }| )
              budat           = ls_memo-hzdat
              datasource      = lv_source
              cert_lvl        = ls_memo-cert_level
              plan_lvl        = ls_memo-ebene
              avdat           = ls_memo-avdat
              zuonr           = ls_memo-merkm
            ) TO gt_snapshot_tab.                        "#EC CI_STDSEQ

            " B.O.C VKANDASAMY FSFXBAM-426
            APPEND VALUE #(
              guid            = guid( )
              bukrs           = ls_memo-bukrs
              gjahr           = lv_timestamp+6(4)
              belnr           = lv_doc
              docln           = ls_memo-idenr+4(6)
              timestamp       = lv_timestmp
              model           = lv_model
              category        = get_snapshot_category( rs_gl      = ls_gl
                                                       rs_fica    = ls_fica
                                                       rs_memo    = ls_memo
                                                       iv_model   = lv_model
                                                       iv_source  = lv_source )
              racct           = ls_memo-bnkko
              rtcur           = ls_memo-dispw
              tsl             = CONV fins_vwcur12( |{ ls_memo-wrshb CURRENCY = ls_memo-dispw }| ) * -1
              rhcur           = ls_memo-waers
              hsl             = CONV fins_vwcur12( |{ ls_memo-dmshb * -1 CURRENCY = ls_memo-waers }| )
              budat           = ls_memo-avdat + 1
              datasource      = lv_source
              cert_lvl        = ls_memo-cert_level
              plan_lvl        = ls_memo-ebene
              avdat           = ls_memo-avdat + 1
              zuonr           = ls_memo-merkm
            ) TO gt_snapshot_tab.                        "#EC CI_STDSEQ
            " E.O.C VKANDASAMY FSFXBAM-426

            CLEAR ls_memo.
          ENDLOOP.
        ENDIF.
      ENDMETHOD.

      METHOD delete_snapshot_comparison.

        SELECT a~*
          FROM ztr_fx_snapshot AS a
          INNER JOIN @gt_snapshot_tab AS b
          ON  a~bukrs      = b~bukrs
          AND a~gjahr      = b~gjahr
          AND a~belnr      = b~belnr
          AND a~fica_opbel = b~fica_opbel
          AND a~fica_augbl = b~fica_augbl
          AND a~docln      = b~docln
          AND a~timestamp  = b~timestamp
        INTO TABLE @DATA(lt_old).

*BOC of JIRA: FSFXBAM-601
