      METHOD update_snapshot_comparison.
        "BOC JIRA: FSFXBAM-601 465794779093
        DATA(lv_records) = lines( gt_snapshot_tab ).
        CLEAR gt_results.
        IF cb_par = abap_true AND gv_sim = abap_true.
          APPEND VALUE #( records = lv_records status = gc_s message = TEXT-s01 ) TO gt_results.
        ENDIF.
        "EOC JIRA: FSFXBAM-601 465794779093

        CHECK gt_snapshot_tab IS NOT INITIAL
          AND gv_sim IS INITIAL.


        delete_snapshot_comparison( ).

        CALL FUNCTION 'ENQUEUE_EZ_TR_SNAPSHOT'
          EXPORTING
            mode_ztr_fx_snapshot = 'X'
            mandt                = sy-mandt
            _wait                = abap_true
          EXCEPTIONS
            foreign_lock         = 1
            system_failure       = 2
            OTHERS               = 3.
        IF sy-subrc = 0.
          MODIFY ztr_fx_snapshot FROM TABLE gt_snapshot_tab.
          IF sy-subrc = 0.
            COMMIT WORK.
*BOC of JIRA: FSFXBAM-601 465794779093
            APPEND VALUE #( records = lv_records status = gc_s message = TEXT-s01 ) TO gt_results.
*EOC of JIRA: FSFXBAM-601 465794779093
            MESSAGE TEXT-s01 TYPE gc_s.
          ENDIF.

          CALL FUNCTION 'DEQUEUE_EZ_TR_SNAPSHOT'
            EXPORTING
              mode_ztr_fx_snapshot = 'X'
              mandt                = sy-mandt.

        ELSE.
          "BOC of JIRA: FSFXBAM-601 465794779093
          APPEND VALUE #( records = 0 status = gc_s message = TEXT-e02 ) TO gt_results.
          "EOC of JIRA: FSFXBAM-601 465794779093
          MESSAGE TEXT-e02 TYPE gc_s.
        ENDIF.
        "BOC of JIRA: FSFXBAM-601 465794779093
        REFRESH gt_snapshot_tab.
        "EOC of JIRA: FSFXBAM-601 465794779093
      ENDMETHOD.

      METHOD convert_to_eur.
        DATA: lv_local_amount TYPE fins_vwcur12.

        CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
          EXPORTING
            date             = iv_date
            foreign_amount   = iv_amt
            foreign_currency = iv_curr
            local_currency   = 'EUR'
          IMPORTING
            local_amount     = lv_local_amount
          EXCEPTIONS
            no_rate_found    = 1
            overflow         = 2
            no_factors_found = 3
            no_spread_found  = 4
            OTHERS           = 5.

        IF sy-subrc = 0.
          rv_tot_eur = lv_local_amount.
        ENDIF.
      ENDMETHOD.

      METHOD get_snapshot_category.
        "Local Data Declaration
        CONSTANTS:lv_function_id TYPE if_fdt_types=>id VALUE '0A7425B8447B1FE0B08FD69C9F39A8EE'.
        DATA:lv_timestamp          TYPE timestamp,
             lt_name_value         TYPE abap_parmbind_tab,
             ls_name_value         TYPE abap_parmbind,
             lr_data               TYPE REF TO data,
             lx_fdt                TYPE REF TO cx_fdt,
             la_model              TYPE if_fdt_types=>element_text,
             la_source             TYPE if_fdt_types=>element_text,
             la_blart              TYPE if_fdt_types=>element_text,
             la_sgtxt              TYPE if_fdt_types=>element_text,
             la_gkont              TYPE if_fdt_types=>element_text,
             la_racct              TYPE if_fdt_types=>element_text,
             la_budat              TYPE if_fdt_types=>element_timepoint,
             la_rwcur              TYPE if_fdt_types=>element_text,
             la_fica_username      TYPE if_fdt_types=>element_text,
             la_fica_doc_type      TYPE if_fdt_types=>element_text,
             la_planning_level     TYPE if_fdt_types=>element_text,
             la_certainty_level    TYPE if_fdt_types=>element_text,
             la_fica_flag          TYPE if_fdt_types=>element_boolean,
             la_zuonr              TYPE if_fdt_types=>element_text,
             la_budat_is_month_end TYPE if_fdt_types=>element_boolean,
             la_shkzg              TYPE if_fdt_types=>element_text,
             la_stream             TYPE if_fdt_types=>element_text,     "(+) of JIRA: FSFXBAM-601 Stream characteristic
             la_ic_operation       TYPE if_fdt_types=>element_boolean,  "(+) of JIRA: FSFXBAM-601 IC Operation Type Characteristic
             la_category           TYPE seqnr.

        GET TIME STAMP FIELD lv_timestamp.

        "Get the model
        ls_name_value-name = 'MODEL'.
        la_model = iv_model.
        GET REFERENCE OF la_model INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'SOURCE'.
        la_source = iv_source.
        GET REFERENCE OF la_source INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'BLART'.
        la_blart = rs_gl-blart.
        GET REFERENCE OF la_blart INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'SGTXT'.
        la_sgtxt = rs_gl-sgtxt.
        GET REFERENCE OF la_sgtxt INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'GKONT'.
        la_gkont = rs_gl-gkont.
        GET REFERENCE OF la_gkont INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'RACCT'.
        la_racct = COND #( WHEN iv_source = 'EXP_HUB'
                           THEN rs_memo-bnkko
                           WHEN rs_gl-awtyp = gc_fkksu  "(+) of JIRA: FSFXBAM-601 When reference is fkksu
                           THEN rs_fica-hkont           "(+) of JIRA: FSFXBAM-601 Then GL account
                           ELSE rs_gl-racct ).
        GET REFERENCE OF la_racct INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'BUDAT'.
        la_budat-type = 'D'.
        la_budat-date = rs_gl-budat.
        GET REFERENCE OF la_budat INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'RWCUR'.
        la_rwcur = COND #( WHEN iv_source = 'EXP_HUB'
                           THEN rs_memo-dispw
                           ELSE rs_gl-rwcur ).
        GET REFERENCE OF la_rwcur INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'FICA_USERNAME'.
        "Get the created user name by passing the Document Number
        la_fica_username = VALUE #( gt_fica_data[ opbel = rs_fica-opbel ]-ernam OPTIONAL ). "#EC CI_STDSEQ
        GET REFERENCE OF la_fica_username INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'FICA_DOC_TYPE'.
        "Get the Document type by passing the Document Number
        la_fica_doc_type = COND #( WHEN rs_gl-awtyp = gc_fkksu
                                   THEN VALUE #( gt_fica_data[ opbel = rs_fica-opbel ]-blart OPTIONAL )     "(+) of JIRA: FSFXBAM-601, fkkssu docs get blart from gt_fica_data
                                   ELSE space ).                                                            "(+) of JIRA: FSFXBAM-601, else space
*    la_fica_doc_type = VALUE #( gt_fica_data[ opbel = rs_fica-opbel ]-blart OPTIONAL ). "#EC CI_STDSEQ     "(-) of JIRA: FSFXBAM-601, 8/18/26, moved above
        GET REFERENCE OF la_fica_doc_type INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'ZUONR'.
        la_zuonr = COND #( WHEN iv_source = 'EXP_HUB'
                           THEN rs_memo-merkm
                           ELSE rs_gl-zuonr ).
        GET REFERENCE OF la_zuonr INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'PLANNING_LEVEL'.
        la_planning_level = rs_memo-ebene.
        GET REFERENCE OF la_planning_level INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'CERTAINTY_LEVEL'.
        la_certainty_level = rs_memo-cert_level.
        GET REFERENCE OF la_certainty_level INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'FICA_FLAG'.
        "Check if the Reference procedure is 'FKKSU'
        la_fica_flag = COND #( WHEN rs_gl-awtyp = gc_fkksu THEN abap_true ).
        GET REFERENCE OF la_fica_flag INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'BUDAT_IS_MONTH_END'.
        "Check if the document date is falls under month end
        la_budat_is_month_end = is_month_end( rs_gl-budat ).
        GET REFERENCE OF la_budat_is_month_end INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.

        ls_name_value-name = 'SHKZG'.
        la_shkzg = COND #( WHEN iv_source = 'EXP_HUB'
                            AND rs_memo-wrshb > 0
                           THEN 'S'
                           ELSE rs_gl-drcrk ).
        GET REFERENCE OF la_shkzg INTO lr_data.
        ls_name_value-value = lr_data.
        INSERT ls_name_value INTO TABLE lt_name_value.
        CLEAR ls_name_value.


        "BOC of JIRA: FSFXBAM-601
        "Set STREAM to BHFS if company code is in gt_tvarvc_bhfs, else BV
        ls_name_value-name = 'STREAM'.
        la_stream = COND #( WHEN line_exists( gt_tvarvc_bhfs[ low = rs_gl-rbukrs ] )
                            THEN 'BHFS'
                            ELSE 'BV' ).
        GET REFERENCE OF la_stream INTO lr_data.
        ls_name_value-value = lr_data.
