  METHOD get_total.
    rv_tot = REDUCE fins_vwcur12( INIT sum = CONV fins_vwcur12( 0 )
                                  FOR x IN gt_category
                                  WHERE ( exposure_curr = iv_curr
                                          AND category = iv_cat )
                                          NEXT sum = sum + x-tot_amt ). "#EC CI_STDSEQ
  ENDMETHOD.

  METHOD convert_to_cc.
    rv_tot = REDUCE fins_vwcur12( INIT sum = CONV fins_vwcur12( 0 )
                                  FOR x IN gt_cc_convert
                                  WHERE ( exposure_curr = iv_curr
                                          AND category = iv_cat )
                                          NEXT sum = sum + x-tot_amt ). "#EC CI_STDSEQ
  ENDMETHOD.

