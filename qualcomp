  METHOD auth.

    " Authorization Check for Company Code access.
    SELECT companycode AS bukrs
    FROM i_companycode
    WHERE companycode IN @s_bukrs[]
    INTO TABLE @DATA(lt_bukrs).

    LOOP AT lt_bukrs ASSIGNING FIELD-SYMBOL(<lfs_bukrs>).
      AUTHORITY-CHECK OBJECT 'F_BKPF_BUK'
                      ID 'BUKRS' FIELD <lfs_bukrs>-bukrs
                      ID 'ACTVT' FIELD '03'.

      IF sy-subrc <> 0.
        MESSAGE TEXT-e05 && <lfs_bukrs>-bukrs TYPE gc_e.
      ENDIF.
    ENDLOOP.

  ENDMETHOD.

  METHOD snap_id.
    IF p_snapfr IS  INITIAL
      AND p_snapto IS INITIAL.

      SELECT *
        FROM fxm_snap
        WHERE description = @gv_snap_desc
        ORDER BY create_timestamp DESCENDING
      INTO TABLE @gt_fxm_snap.                "#EC CI_ALL_FIELDS_NEEDED
      IF sy-subrc = 0.
        p_snapfr = VALUE #( gt_fxm_snap[ 2 ]-snap_id OPTIONAL ).

        p_snapto = VALUE #( gt_fxm_snap[ 1 ]-snap_id OPTIONAL ).
      ENDIF.
    ENDIF.
  ENDMETHOD.

  METHOD f4_snap_id.
    TYPES: BEGIN OF ty_snap_help,
             snap_id     TYPE fxm_snap_id,
             keydate     TYPE fxm_key_date,
             create_user TYPE rerf,
             create_date TYPE fxm_create_date,
             create_time TYPE fxm_create_time,
             description TYPE fxm_snap_description,
           END OF ty_snap_help.

    DATA: lt_snap_help TYPE STANDARD TABLE OF ty_snap_help.

    LOOP AT gt_fxm_snap INTO DATA(x).
      CONVERT TIME STAMP x-create_timestamp TIME ZONE sy-zonlo
              INTO DATE DATA(lv_date) TIME DATA(lv_time).

      APPEND VALUE #(
        snap_id     = x-snap_id
        keydate     = x-keydate
        create_user = x-create_user
        create_date = lv_date
        create_time = lv_time
        description = x-description
      ) TO lt_snap_help.
    ENDLOOP.

    CHECK lt_snap_help IS NOT INITIAL.
    CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
      EXPORTING
        retfield        = 'SNAP_ID'
        dynpprog        = sy-repid
        dynpnr          = sy-dynnr
        dynprofield     = iv_snap
        value_org       = 'S'
      TABLES
        value_tab       = lt_snap_help
      EXCEPTIONS
        parameter_error = 1
        no_values_found = 2
        OTHERS          = 3 ##FM_SUBRC_OK.
  ENDMETHOD.

  METHOD validate_selection.
    gs_snapfrom = get_snapshot( iv_snapid = p_snapfr ).
    gs_snapto   = get_snapshot( iv_snapid = p_snapto ).

    " Read snapshots from FXM_SNAP
    IF gs_snapfrom-snap_id IS INITIAL OR gs_snapto-snap_id IS INITIAL.
      MESSAGE TEXT-e01 TYPE gc_e DISPLAY LIKE gc_s.
    ENDIF.

    " KEYDATE difference not more than 10 days
    DATA(lv_diff) = gs_snapto-keydate - gs_snapfrom-keydate.
    IF lv_diff < 0.
      lv_diff = lv_diff * -1.
    ENDIF.

    IF lv_diff > 10.
      MESSAGE TEXT-e02 TYPE gc_e DISPLAY LIKE gc_s.
    ENDIF.

    " CREATE_TIMESTAMP(from) <= CREATE_TIMESTAMP(to)
    IF gs_snapfrom-create_timestamp > gs_snapto-create_timestamp.
      MESSAGE TEXT-e03 TYPE gc_e DISPLAY LIKE gc_s.
    ENDIF.

    SELECT DISTINCT waers
      FROM t001
      WHERE bukrs IN @s_bukrs
    INTO TABLE @DATA(lt_waers).
    IF sy-subrc = 0.
      DATA(lv_count) = lines( lt_waers ).
      IF lv_count > 1.
        MESSAGE TEXT-e06 TYPE gc_e DISPLAY LIKE gc_s.
      ELSE.
        gv_cc_cur = VALUE #( lt_waers[ 1 ]-waers OPTIONAL ).
      ENDIF.
    ENDIF.

*BOC of JIRA: FSFXBAM-601
    IF lines( s_model ) > 1.
      SELECT companycode FROM i_companycode
       WHERE companycode IN   @s_bukrs
        INTO TABLE @DATA(lt_bukrs).

      "Check if company codes have non bhfs-codes
      IF sy-subrc = 0.
        LOOP AT lt_bukrs ASSIGNING FIELD-SYMBOL(<ls_cc>).
          IF NOT line_exists( gt_bhfs[ low = <ls_cc>-companycode ] ).
            MESSAGE TEXT-e07 TYPE gc_e DISPLAY LIKE gc_s.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.
    ENDIF.
*EOC of JIRA: FSFXBAM-601
  ENDMETHOD.

