  METHOD get_snapshot.
    SELECT SINGLE
      snap_id,
      keydate,
      create_timestamp
    FROM fxm_snap
    INTO @is_snap
    WHERE snap_id = @iv_snapid.
  ENDMETHOD.

  METHOD get_data.
    FREE gt_stage.

    SELECT *
      FROM ztr_fx_snapshot
      WHERE ( ( avdat IS NOT INITIAL AND avdat >= @gs_snapfrom-keydate )
         OR ( avdat IS INITIAL ) )
        AND ( ( timestamp    BETWEEN @gs_snapfrom-create_timestamp
                             AND @gs_snapto-create_timestamp   )
        OR ( timestamp   <= @gs_snapfrom-create_timestamp
        AND budat        > @gs_snapfrom-keydate ) )
        AND budat        <= @gs_snapto-keydate
*        AND model        = @p_model              "(-) of JIRA: FSFXBAM-601, replaced to s_model
        AND model        IN @s_model              "(+) of JIRA: FSFXBAM-601
        AND bukrs        IN @s_bukrs
      INTO TABLE @gt_stage.

    IF gt_stage IS NOT INITIAL.
      " Exception logic for MEMO records
*      process_memo( ).
    ELSE.
      MESSAGE TEXT-e04 TYPE gc_s DISPLAY LIKE gc_e.
    ENDIF.
  ENDMETHOD.

  METHOD process_memo.
    DATA: ls_memo TYPE ztr_fx_snapshot,
          lt_memo TYPE tyt_stage.

    SELECT *
      FROM ztr_fx_snapshot
      WHERE budat    = @gs_snapfrom-keydate
        AND cert_lvl = @gc_memo
*BOC of JIRA: FSFXBAM-348
*       AND model    = @p_model           "(-) of JIRA: FSFXBAM-601
        AND model    IN @s_model          "(+) of JIRA: FSFXBAM-601
        AND bukrs    IN @s_bukrs
*EOC of JIRA: FSFXBAM-348
      INTO TABLE @DATA(lt_memo_tmp).
    IF lt_memo_tmp IS NOT INITIAL.
      LOOP AT lt_memo_tmp ASSIGNING FIELD-SYMBOL(<memo>).
        ls_memo = VALUE #( gt_stage[ bukrs    = <memo>-bukrs
                                     racct    = <memo>-racct
                                     plan_lvl = <memo>-plan_lvl
                                     rtcur    = <memo>-rtcur ] OPTIONAL ). "#EC CI_STDSEQ
        IF ls_memo IS INITIAL.
          IF <memo>-model = 1 AND <memo>-category = '006'.
            <memo>-tsl = <memo>-tsl * - 1.
            <memo>-hsl = <memo>-hsl * - 1.
            lt_memo = VALUE #( BASE lt_memo ( <memo> ) ).
          ENDIF.
        ELSE.
          <memo>-tsl = <memo>-tsl * - 1.
          <memo>-hsl = <memo>-hsl * - 1.
          lt_memo = VALUE #( BASE lt_memo ( <memo> ) ).
        ENDIF.
      ENDLOOP.

      CLEAR gt_stage.

      IF lt_memo IS NOT INITIAL.
        gt_stage = VALUE #( BASE gt_stage
                            FOR memo IN lt_memo
                                    ( memo ) ).
      ENDIF.
    ENDIF.
  ENDMETHOD.

  METHOD aggregate.
    SORT gt_stage BY rtcur.
    gt_exposure_curr = VALUE #( FOR GROUPS s OF stage IN gt_stage
                                GROUP BY stage-rtcur
                                ( exposure_curr = s
                                  tot_amt       = REDUCE fins_vwcur12( INIT sum = CONV fins_vwcur12( 0 )
                                                                       FOR x IN GROUP s
                                                                       NEXT sum = sum + x-tsl )
                                  tot_cc_amt    = REDUCE fins_vhcur12( INIT sum = CONV fins_vhcur12( 0 )
                                                                       FOR x IN GROUP s
                                                                       NEXT sum = sum + x-hsl ) ) ).

    SORT gt_stage BY model rtcur category.
    gt_category = VALUE #( FOR GROUPS c OF category IN gt_stage
                           GROUP BY ( rtcur = category-rtcur
                                      category = category-category )
                           ( exposure_curr = c-rtcur
                             category      = c-category
                             tot_amt       = REDUCE fins_vwcur12( INIT sum = CONV fins_vwcur12( 0 )
                                                                  FOR y IN GROUP c
                                                                  NEXT sum = sum + y-tsl ) ) ).

    gt_cc_convert = VALUE #( FOR GROUPS d OF category IN gt_stage
                             GROUP BY ( rtcur = category-rtcur
                                        category = category-category )
                           ( exposure_curr = d-rtcur
                             category      = d-category
                             tot_amt       = REDUCE fins_vhcur12( INIT sum = CONV fins_vhcur12( 0 )
                                                                               FOR z IN GROUP d
                                                                               NEXT sum = sum + z-hsl ) ) ).

  ENDMETHOD.
