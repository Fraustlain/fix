*EOC of JIRA: FSFXBAM-601

    "Delete entries when fica_flag is active
    DELETE gt_main_dtl_alv WHERE fica_flag = abap_true.  "#EC CI_STDSEQ
    gt_main_dtl_alv =  VALUE #( BASE gt_main_dtl_alv
                                FOR agg IN lt_main_agg
                         ( CORRESPONDING #( agg ) ) ).   "#EC CI_STDSEQ

  ENDMETHOD.

  METHOD on_sub_click.
    "Check if the selected entry exists.
    IF line_exists( gt_main_dtl_alv[ row ] ).
      DATA(ls_main) = gt_main_dtl_alv[ row ].

      CASE column.
        WHEN 'BELNR'.
          IF ls_main-cert_lvl = 'MEMO'.
            SET PARAMETER ID 'FFI' FIELD ls_main-belnr.
            CALL TRANSACTION 'FF65' AND SKIP FIRST SCREEN.
*            CALL TRANSACTION 'FF65' WITH AUTHORITY-CHECK AND SKIP FIRST SCREEN.
          ELSE.
            SET PARAMETER ID 'BLN' FIELD ls_main-belnr.
            SET PARAMETER ID 'BUK' FIELD ls_main-bukrs.
            SET PARAMETER ID 'GJR' FIELD ls_main-gjahr.
            CALL TRANSACTION 'FB03' AND SKIP FIRST SCREEN.
*            CALL TRANSACTION 'FB03' WITH AUTHORITY-CHECK AND SKIP FIRST SCREEN.
          ENDIF.
        WHEN OTHERS.
      ENDCASE.
    ENDIF.
  ENDMETHOD.

  METHOD display_main_dtl_alv.
    "Data declaration for ALV Display
    DATA: lo_cols TYPE REF TO cl_salv_columns_table,
          lo_col  TYPE REF TO cl_salv_column_table,
          lo_func TYPE REF TO cl_salv_functions_list,
          lt_cols TYPE salv_t_column_ref.

    TRY.
        "Class to display ALV
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lo_main_dtl)
                                CHANGING  t_table      = gt_main_dtl_alv ).

        lo_cols = lo_main_dtl->get_columns( ).
        lo_cols->set_optimize( abap_true ).
        lt_cols = lo_cols->get( ).
        LOOP AT lt_cols INTO DATA(ls_cols).
          lo_col ?= lo_cols->get_column( ls_cols-columnname ).
          IF ls_cols-columnname = 'BELNR'.
            lo_col->set_cell_type( if_salv_c_cell_type=>hotspot ).
          ENDIF.
          IF ls_cols-columnname = 'MANDT' OR
            ls_cols-columnname = 'FICA_FLAG'.
            lo_col->set_visible( if_salv_c_bool_sap=>false ).
          ENDIF.
          IF ls_cols-columnname = 'TIMESTAMP' ##NO_TEXT.
            lo_col->set_short_text( 'Timestamp' ) ##NO_TEXT.
            lo_col->set_medium_text( 'Create Timestamp' ) ##NO_TEXT.
            lo_col->set_long_text( 'Create Timestamp' ) ##NO_TEXT.
          ENDIF.
        ENDLOOP.
        "Call method to get all the Functions
        lo_main_dtl->get_functions( )->set_all( abap_true ).
        "Set Zebra pattern on ALV output
        lo_main_dtl->get_display_settings( )->set_striped_pattern( abap_true ).

        DATA(lo_events_main) = lo_main_dtl->get_event( ).
        "Event handler for single click on the entry
        SET HANDLER go_main->on_sub_click FOR lo_events_main.

        lo_main_dtl->display( ).

      CATCH cx_salv_not_found  INTO DATA(lo_not_found).
        MESSAGE lo_not_found->get_text( ) TYPE gc_e.

      CATCH cx_salv_msg INTO DATA(lx).
        MESSAGE lx->get_text( ) TYPE gc_e.
    ENDTRY.
  ENDMETHOD.

  METHOD get_main_dtl.
    IF iv_cat IS INITIAL.
      rt_stage = VALUE #( FOR drilldown IN gt_stage
                          WHERE ( rtcur = iv_curr )
                                   ( drilldown ) ).      "#EC CI_STDSEQ
    ELSE.
      rt_stage = VALUE #( FOR drilldown IN gt_stage
                          WHERE ( rtcur = iv_curr
                                  AND category = iv_cat
                                  AND model = iv_model ) "(+) of JIRA:FSFXBAM-601
                                         ( drilldown ) ). "#EC CI_STDSEQ
    ENDIF.
  ENDMETHOD.

*BOC of JIRA: FSFXBAM-348
  METHOD build_categories.
    SELECT *
      FROM ztr_fx_snapcat
      INTO TABLE @gt_snapcat
*     WHERE model = @p_model.                 "#EC CI_ALL_FIELDS_NEEDED   "(-) of JIRA: FSFXBASM-601
      WHERE model IN @s_model.                                            "(+) of JIRA: FSFXBASM-601
    SORT gt_snapcat BY priority ASCENDING.
  ENDMETHOD.

  METHOD build_structure.
    "Fixed column/s
    APPEND VALUE #( name = 'EXPOSURE_CURR'
                    type = cl_abap_elemdescr=>get_c( 5 ) ) TO gt_comp.

    APPEND VALUE #( name = 'TOT_MOVEMENT'
                    type = cl_abap_elemdescr=>get_p( p_length = 16 p_decimals = 2 ) ) TO gt_comp.

    "Dynamic colum/s per category
    LOOP AT gt_snapcat ASSIGNING FIELD-SYMBOL(<c>).
*     DATA(lv_f1) = |TOT_{ <c>-priority }|.                "(-) of JIRA: FSFXBAM-601
      DATA(lv_f1) = |TOT_{ <c>-model }_{ <c>-priority }|.  "(+) of JIRA: FSFXBAM-601

      APPEND VALUE #( name = lv_f1
                      type = cl_abap_elemdescr=>get_p( p_length = 16 p_decimals = 2 ) ) TO gt_comp.
    ENDLOOP.

    "Fixed columns/s
    APPEND VALUE #( name = 'TOT_MOVEMENT_CC'
                    type = cl_abap_elemdescr=>get_p( p_length = 16 p_decimals = 2 ) ) TO gt_comp.

    "Dynamic colum/s per category
    LOOP AT gt_snapcat ASSIGNING FIELD-SYMBOL(<cc>).
*     DATA(lv_f2) = |TOT_{ <cc>-priority }_CC|.                "(-) of JIRA: FSFXBAM-601
      DATA(lv_f2) = |TOT_{ <cc>-model }_{ <cc>-priority }_CC|. "(+) of JIRA: FSFXBAM-601

      APPEND VALUE #( name = lv_f2
                      type = cl_abap_elemdescr=>get_p( p_length = 16 p_decimals = 2 ) ) TO gt_comp.
    ENDLOOP.
  ENDMETHOD.

  METHOD build_table.
    DATA: lo_struc TYPE REF TO cl_abap_structdescr,
          lo_tab   TYPE REF TO cl_abap_tabledescr,
          lr_tab   TYPE REF TO data.

    lo_struc = cl_abap_structdescr=>create( gt_comp ).
    lo_tab   = cl_abap_tabledescr=>create( lo_struc ).
    CREATE DATA lr_tab TYPE HANDLE lo_tab.

    ASSIGN lr_tab->* TO <gt_out>.
  ENDMETHOD.

  METHOD fill_table.
    FIELD-SYMBOLS: <wa>  TYPE any,
                   <val> TYPE any.

    LOOP AT gt_exposure_curr ASSIGNING FIELD-SYMBOL(<a>).
      APPEND INITIAL LINE TO <gt_out> ASSIGNING <wa>.

      "Fixed cols
      ASSIGN COMPONENT 'EXPOSURE_CURR' OF STRUCTURE <wa> TO <val>.
      <val> = <a>-exposure_curr.

      ASSIGN COMPONENT 'TOT_MOVEMENT' OF STRUCTURE <wa> TO <val>.
      <val> = <a>-tot_amt.

      ASSIGN COMPONENT 'TOT_MOVEMENT_CC' OF STRUCTURE <wa> TO <val>.
      <val> = <a>-tot_cc_amt.

      "Dynamic cols per category
      LOOP AT gt_snapcat ASSIGNING FIELD-SYMBOL(<c>).
*        DATA(lv_f1) = |TOT_{ <c>-priority }|.                  "(-) of JIRA: FSFXBAM-601
*        DATA(lv_f2) = |TOT{ <c>-priority }_CC|.                "(-) of JIRA: FSFXBAM-601d
        DATA(lv_f1) = |TOT_{ <c>-model }_{ <c>-priority }|.     "(+) of JIRA: FSFXBAM-601
        DATA(lv_f2) = |TOT_{ <c>-model }_{ <c>-priority }_CC|.  "(+) of JIRA: FSFXBAM-601

        ASSIGN COMPONENT lv_f1 OF STRUCTURE <wa> TO <val>.
        IF sy-subrc = 0.
          <val> = get_total( iv_curr = <a>-exposure_curr iv_cat = <c>-priority ).
        ENDIF.

        ASSIGN COMPONENT lv_f2 OF STRUCTURE <wa> TO <val>.
        IF sy-subrc = 0.
          <val> = convert_to_cc( iv_curr = <a>-exposure_curr iv_cat = <c>-priority ).
        ENDIF.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.

  METHOD build_alv.
    "Data declarations for ALV Display
    DATA: lo_cols TYPE REF TO cl_salv_columns_table,
          lo_col  TYPE REF TO cl_salv_column_table,
          lo_func TYPE REF TO cl_salv_functions_list,
          lt_cols TYPE salv_t_column_ref.

*BOC of JIRA: FSFXBAM-601
    DATA: lv_model TYPE zde_model,
          lv_prio  TYPE seqnr.
*EOC of JIRA: FSFXBAM-601

    CHECK <gt_out> IS NOT INITIAL.

    TRY.
        "Class to display ALV
        cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lo_agency_alv)
                                CHANGING  t_table      = <gt_out> ).

        lo_cols = lo_agency_alv->get_columns( ).
        lo_cols->set_optimize( abap_true ).
        lt_cols = lo_cols->get( ).
        LOOP AT lt_cols INTO DATA(ls_cols).

*BOC of JIRA: FSFXBAM-601
          CLEAR: lv_model, lv_prio.
          SPLIT ls_cols-columnname AT '_' INTO DATA(lv_t0) DATA(lv_t1) DATA(lv_t2) DATA(lv_t3).
          lv_model = lv_t1.
          lv_prio  = lv_t2.
*EOC of JIRA: FSFXBAM-601

*          DATA(lv_text)   = VALUE #(  gt_snapcat[ priority = ls_cols-columnname+4(3) ]-name OPTIONAL ).  "(-) of JIRA: FSFXBAM-601
          DATA(lv_text)   = VALUE #(  gt_snapcat[ model = lv_model priority = lv_prio ]-name OPTIONAL ).  "(+) of JIRA: FSFXBAM-601
          DATA(lv_header) = COND scrtext_l( WHEN ls_cols-columnname EQ 'EXPOSURE_CURR'    THEN TEXT-am0
                                            WHEN ls_cols-columnname EQ 'TOT_MOVEMENT'     THEN TEXT-am1
                                            WHEN ls_cols-columnname EQ 'TOT_MOVEMENT_CC'  THEN |{ TEXT-am1 }({ gv_cc_cur })|
                                            WHEN ls_cols-columnname CP 'TOT*CC*'          THEN |{ lv_text }({ gv_cc_cur })|
                                            ELSE lv_text ).

          DATA(lv_hotspot) = COND #( WHEN ls_cols-columnname CP '*CC*'
                                     THEN abap_false
                                     ELSE abap_true ).
          lo_col ?= lo_cols->get_column( ls_cols-columnname ).
          lo_col->set_short_text( '' ).
          lo_col->set_medium_text( '' ).
          lo_col->set_long_text( lv_header ).
          lo_col->set_fixed_header_text( 'L' ).
          IF lv_hotspot = abap_true.
            "Enable Hotspot for the column which has 'CC'
            lo_col->set_cell_type( if_salv_c_cell_type=>hotspot ).
          ENDIF.
        ENDLOOP.

        "Get all ALV functions
        lo_agency_alv->get_functions( )->set_all( abap_true ).
        lo_agency_alv->get_display_settings( )->set_striped_pattern( abap_true ).

        DATA(lo_events_agency) = lo_agency_alv->get_event( ).
        SET HANDLER go_main->on_main_click FOR lo_events_agency.

        lo_agency_alv->display( ).

      CATCH cx_salv_not_found  INTO DATA(lo_not_found).
        MESSAGE lo_not_found->get_text( ) TYPE gc_e.

      CATCH cx_salv_msg INTO DATA(lx).
        MESSAGE lx->get_text( ) TYPE gc_e.
    ENDTRY.
  ENDMETHOD.
*EOC of JIRA: FSFXBAM-348
ENDCLASS.
